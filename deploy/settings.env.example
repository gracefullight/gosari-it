# 로컬 설정 예시 — 실제 비밀은 .local/secrets/에 둔다 (Git 제외).
# 이 파일에는 placeholder만 둔다.
APP_PROFILE=center
APP_PORT=8765
EXTERNAL_REQUESTS_ENABLED=false
LLM_MODEL=gpt-6-luna
RESPONSE_CACHE_ENABLED=true
ALLOW_NOTEBOOK_IMPORT=false
ALLOW_NOTEBOOK_EXPORT=false
ALLOW_SHARE_FILE=false
# 지도 타일 제공처 (승인 후 설정). 비우면 UI는 타일 요청 없이 관측소 목록 표시.
TILE_PROVIDER_CONFIG=
# 검증된 유사도 문턱값 (미설정 시 semantic 조회 우회, exact만 사용)
DOMAIN_THRESHOLD_CONFIG=