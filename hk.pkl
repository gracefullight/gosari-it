amends "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Config.pkl"

/// Git hooks. Pre-commit checks only staged paths without rewriting them.
/// Pre-push checks changed files and related tests in order. A failed check
/// blocks the push. Passes are cached by content in scripts/pre-push.sh.

hooks {
  ["pre-commit"] {
    fix = false
    steps {
      ["api"] {
        glob = "apps/api/**/*.py"
        check = ".venv/bin/ruff check --no-fix {{files}} && .venv/bin/ruff format --check {{files}}"
      }
      ["web"] {
        glob = List("apps/web/**/*.{ts,tsx,js,jsx,json,jsonc,css}", "biome.json", "package.json")
        check = "./apps/web/node_modules/.bin/biome check --no-errors-on-unmatched --error-on-warnings {{files}}"
      }
      ["hadolint"] {
        glob = List("**/Dockerfile", "**/Dockerfile.*")
        check = "hadolint {{files}}"
      }
    }
  }
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "./node_modules/.bin/commitlint --edit {{commit_msg_file}}"
      }
    }
  }
  ["pre-push"] {
    fix = false
    stash = "none"
    steps {
      ["branch"] {
        check = "scripts/pre-push.sh gate branch"
      }
      ["api"] {
        depends = "branch"
        check = "scripts/pre-push.sh gate api"
      }
      ["web"] {
        depends = "api"
        check = "scripts/pre-push.sh gate web"
      }
    }
  }
}
