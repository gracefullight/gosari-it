# 네이티브 개발용 예시 — 실제 값/키를 넣지 않는다. 비밀은 .local/secrets/ 사용.
APP_PROFILE=center
APP_HOST=127.0.0.1
APP_PORT=8765
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gosari_public
DB_USER=gosari_app
DB_PASSWORD_FILE=.local/secrets/db_app_password
EXTERNAL_REQUESTS_ENABLED=false
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY_FILE=.local/secrets/openai_api_key
RESPONSE_CACHE_ENABLED=true
EMBEDDING_MODEL_PATH=intfloat/multilingual-e5-small
EMBEDDING_REVISION=main
FIXTURES_DIR=fixtures
ALLOW_NOTEBOOK_IMPORT=false
ALLOW_NOTEBOOK_EXPORT=false
ALLOW_SHARE_FILE=false